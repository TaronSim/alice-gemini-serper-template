# Required: Google AI Studio Gemini API key
GEMINI_API_KEY=

# Required for internet search; if omitted, regular Gemini answers still work
SERPER_API_KEY=

# Optional; default is a fast and cost-efficient Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional protection; your skill ID from Yandex Dialogs. When set, requests from other skills are rejected.
ALICE_SKILL_ID=

# Optional but recommended; Upstash Redis lets slow answers finish in the background ("скажите «дальше»").
# Vercel fills these in when you connect Upstash Redis via Storage; KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
