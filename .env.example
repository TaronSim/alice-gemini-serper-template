# Required: Google AI Studio Gemini API key
GEMINI_API_KEY=

# Required for internet search; if omitted, regular Gemini answers still work
SERPER_API_KEY=

# Optional; default is a fast and cost-efficient Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional protection; your skill ID from Yandex Dialogs. When set, requests from other skills are rejected.
ALICE_SKILL_ID=
