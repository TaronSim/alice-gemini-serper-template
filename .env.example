# Required: Google AI Studio Gemini API key
GEMINI_API_KEY=

# Optional; the model that answers. Default: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Optional; low / medium / high. Empty lets Gemini choose, like in the Gemini app.
GEMINI_THINKING_LEVEL=

# Optional; "off" disables Grounding with Google Search
GEMINI_GOOGLE_SEARCH=

# Optional protection; your skill ID from Yandex Dialogs. When set, requests from other skills are rejected.
ALICE_SKILL_ID=

# Needed for full answers; Upstash Redis lets slow answers finish in the background ("скажите «дальше»").
# Vercel fills these in when you connect Upstash Redis via Storage; KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
